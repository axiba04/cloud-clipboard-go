name = "cloud-clipboard-worker"
main = "src/index.js"
compatibility_date = "2025-08-01"
# 浏览器导航到下载接口时也进入 Worker，不能被 SPA 首页回退接管。
compatibility_flags = ["nodejs_compat", "assets_navigation_has_no_effect"]

# 托管 Vue3 前端静态资源（web-vue3/dist 的拷贝）
# 静态资源与 SPA 页面导航由静态资源服务处理；
# 文件下载和内容分享即使由浏览器导航发起，也必须进入 Worker，避免返回 index.html。
[assets]
directory = "./assets"
not_found_handling = "single-page-application"
binding = "ASSETS"

# 环境变量
[vars]
AUTH_PASSWORD = "123"
# 房间认证配置。值支持两种形式：
#   字符串/数字: 仅密码（旧格式）
#   对象: {"password": "xx", "fileExpire": 0}
#     fileExpire: 0=该房间文件永不过期；>0=覆盖 FILE_EXPIRE 的秒数；不填=使用全局 FILE_EXPIRE
ROOM_AUTH_JSON = "{\"private\":\"\",\"finance\":{\"password\":\"finance-pass\",\"fileExpire\":0},\"tmp\":\"quick-pass\"}"
ROOM_LIST = "true"
HISTORY_LIMIT = "50"
TEXT_LIMIT = "40960"
FILE_LIMIT = "204857600"
FILE_EXPIRE = "3600"

# D1 数据库绑定 (将被自动更新)
[[d1_databases]]
binding = "DB"
database_name = "cloud-clipboard-db"
database_id = "your-d1-database-id"

# R2 存储绑定
[[r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "cloud-clipboard-files"

# Durable Objects
[[durable_objects.bindings]]
name = "WEBSOCKET_ROOM"
class_name = "WebSocketRoom"
script_name = "cloud-clipboard-worker"

# Durable Objects 迁移
[[migrations]]
tag = "v1"
new_sqlite_classes = ["WebSocketRoom"]
